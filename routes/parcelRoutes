const express = require("express");
const router = express.Router();
const {
  listParcels,
  getParcel,
  createParcel,
  updateParcel,
  deleteParcel,
} = require("../controllers/parcelController");

const { authenticate, authorizeAdmin } = require("../middleware/auth");

// Public routes
router.get("/", listParcels);
router.get("/:id", getParcel);

// Admin-only routes
router.post("/", authenticate, authorizeAdmin, createParcel);
router.put("/:id", authenticate, authorizeAdmin, updateParcel);
router.delete("/:id", authenticate, authorizeAdmin, deleteParcel);

module.exports = router;
